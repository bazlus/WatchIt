# Copy to .env.local and fill in. .env.local is git-ignored.

# Local Supabase (from `npm run db:start`). For hosted Supabase use the
# connection string from Project Settings > Database.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# TMDB credentials from https://www.themoviedb.org/settings/api. Set one of them:
# the "API Read Access Token" (preferred) or the short v3 "API Key".
TMDB_API_READ_TOKEN=
TMDB_API_KEY=

# Voyage AI key from https://dashboard.voyageai.com/
VOYAGE_API_KEY=

# Languages to store TMDB translations for (ISO 639-1, comma-separated).
TRANSLATION_LANGS=de,es,fr
